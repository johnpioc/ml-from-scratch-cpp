#include <jmll/core/matrix.hpp>
#include <jmll/core/vector.hpp>
#include <memory>

namespace jmll::core {
using jmll::core::Matrix;
using jmll::core::Vector;

class KDNode {
   private:
    Vector key_;
    int dimIndex_;
    double value_;
    std::shared_ptr<KDNode> left_;
    std::shared_ptr<KDNode> right_;

   public:
    KDNode(const Vector& key, int dimIndex, double value);

    void setLeft(const KDNode& node);
    KDNode* getLeft();

    void setRight(const KDNode& node);
    KDNode* getRight();
};

class KDTree {
   private:
    std::shared_ptr<KDNode> root_;
    int size_;

   public:
};
}  // namespace jmll::core
